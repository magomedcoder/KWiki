{{define "content"}}
{{template "tabs" (dict "Aria" (t .Lang "nav.page_actions") "Items" (list (dict "Label" (t .Lang "page.read") "Href" .Cancel) (dict "Label" (t .Lang "page.edit") "Current" true)))}}
{{template "title" .Title}}
<form method="POST" action="/edit" class="editor" data-branch="{{.Branch}}" data-max-media="2097152">
  <input type="hidden" name="csrf" value="{{.CSRF}}">
  <div class="grid items-start gap-x-6 md:grid-cols-[minmax(0,1fr)_12rem]">
    {{template "field" (dict "Label" (t .Lang "edit.address") "Type" "text" "Name" "slug" "Value" .Slug "Required" true "Readonly" (not .IsNew) "Spellcheck" false)}}
    {{if .IsNew}}
    {{template "label-start" (t .Lang "edit.branch")}}
      <select class="w-full rounded-sm border border-wiki-line bg-white px-2.5 py-2 text-base text-wiki-ink focus:border-wiki-muted focus:outline-2 focus:outline-[#d9dde3]" name="branch" id="editor-branch">
        {{range .Branches}}
        <option value="{{.Name}}" {{if eq .Name $.Branch}}selected{{end}}>{{.Name}}{{if not .Public}}{{ t $.Lang "edit.branch_private" }}{{end}}</option>
        {{end}}
      </select>
    {{template "label-end"}}
    {{else}}
    <input type="hidden" name="branch" value="{{.Branch}}" id="editor-branch">
    {{template "field" (dict "Label" (t .Lang "edit.branch") "Type" "text" "Value" .Branch "Readonly" true)}}
    {{end}}
  </div>

  <div class="editor-split group mt-4" data-mode="edit">
    <div class="flex flex-wrap items-center justify-between gap-1.5">
      <div class="editor-tools flex flex-wrap gap-1.5 group-data-[mode=preview]:hidden">
        {{template "button" (dict "Type" "button" "Label" (t .Lang "edit.bold") "Before" "**" "After" "**" "Placeholder" (t .Lang "edit.ph_text"))}}
        {{template "button" (dict "Type" "button" "Label" (t .Lang "edit.italic") "Before" "*" "After" "*" "Placeholder" (t .Lang "edit.ph_text"))}}
        {{template "button" (dict "Type" "button" "Label" (t .Lang "edit.heading") "Before" "# " "Placeholder" (t .Lang "edit.ph_heading"))}}
        {{template "button" (dict "Type" "button" "Label" (t .Lang "edit.list") "Before" "- " "Placeholder" (t .Lang "edit.ph_item"))}}
        {{template "button" (dict "Type" "button" "Label" (t .Lang "edit.code") "Before" "`" "After" "`" "Placeholder" (t .Lang "edit.ph_code"))}}
        {{template "button" (dict "Type" "button" "Label" (t .Lang "edit.link") "Before" "[" "After" (t .Lang "edit.link_after") "Placeholder" (t .Lang "edit.ph_link"))}}
        {{template "button" (dict "Type" "button" "Label" (t .Lang "edit.upload_media") "Media" "upload")}}
        {{template "button" (dict "Type" "button" "Label" (t .Lang "edit.from_uploaded") "Media" "pick")}}
        {{template "text-link" (dict "Href" "/help" "Label" (t .Lang "nav.help"))}}
      </div>
      <div class="editor-modes ms-auto flex flex-wrap gap-1.5">
        {{template "button" (dict "Type" "button" "Label" (t .Lang "edit.mode_edit") "Mode" "edit" "Active" true)}}
        {{template "button" (dict "Type" "button" "Label" (t .Lang "edit.mode_preview") "Mode" "preview")}}
      </div>
    </div>

    <label class="editor-source my-3.5 flex flex-col gap-1.5 text-sm text-wiki-muted group-data-[mode=preview]:hidden">
      {{ t .Lang "edit.text" }}
      <textarea
        class="h-[calc(100dvh-16rem)] min-h-[28rem] w-full resize-y rounded-sm border border-wiki-line bg-white px-2.5 py-2 font-mono text-sm leading-snug text-wiki-ink focus:border-wiki-muted focus:outline-2 focus:outline-[#d9dde3] max-md:h-[calc(100dvh-20rem)] max-md:min-h-[22rem]"
        name="content"
        rows="24"
        spellcheck="false"
        required
      >{{.Content}}</textarea>
    </label>
    <section class="preview mt-3 hidden min-h-[28rem] flex-col rounded-sm border border-wiki-line-soft bg-wiki-well p-4 group-data-[mode=preview]:flex max-md:min-h-[22rem]" aria-live="polite">
      {{template "prose" (dict "Class" "preview-body flex-1" "Body" .Preview)}}
    </section>
  </div>

  {{template "actions-start"}}
    {{template "button" (dict "Type" "submit" "Label" (t .Lang "common.save"))}}
    {{template "text-link" (dict "Href" .Cancel "Label" (t .Lang "common.cancel"))}}
  {{template "actions-end"}}
</form>

<dialog class="m-auto w-[min(36rem,calc(100vw-2rem))] max-h-[min(40rem,calc(100vh-2rem))] overflow-auto rounded-sm border border-wiki-line bg-white p-4 text-wiki-ink shadow-lg backdrop:bg-black/30" id="media-upload-dialog">
  <form method="dialog" class="mb-3 flex items-start justify-between gap-3">
    <h2 class="m-0 font-serif text-xl font-normal">{{ t .Lang "media.upload_title" }}</h2>
    <button class="inline-flex min-h-8 cursor-pointer items-center rounded-sm border border-wiki-line bg-wiki-well px-2 py-1 text-sm" value="cancel" type="submit">{{ t .Lang "common.close" }}</button>
  </form>
  <p class="mt-0 mb-3 text-sm text-wiki-muted">{{ t .Lang "media.upload_hint" }}</p>
  <div class="mb-3 flex flex-col gap-2">
    <button class="wiki-btn wiki-btn-solid w-full" type="button" id="media-file-pick">{{ t .Lang "media.choose_file" }}</button>
    <p class="m-0 text-sm text-wiki-muted" id="media-file-name">{{ t .Lang "media.no_file" }}</p>
    <input class="sr-only" type="file" id="media-file">
  </div>
  <label class="mb-2 flex flex-col gap-1 text-sm text-wiki-muted">{{ t .Lang "media.folder" }}
    <select class="w-full rounded-sm border border-wiki-line bg-white px-2.5 py-2 text-base text-wiki-ink" id="media-folder-pick">
      <option value="">{{ t .Lang "media.root" }}</option>
      <option value="__new__">{{ t .Lang "media.new_folder_option" }}</option>
    </select>
  </label>
  <label class="mb-2 hidden flex-col gap-1 text-sm text-wiki-muted" id="media-folder-new">{{ t .Lang "media.new_folder" }}
    <input class="w-full rounded-sm border border-wiki-line bg-white px-2.5 py-2 text-base text-wiki-ink" type="text" id="media-folder" placeholder="например screenshots" spellcheck="false">
  </label>
  <label class="mb-2 flex flex-col gap-1 text-sm text-wiki-muted">{{ t .Lang "media.file_name" }}
    <input class="w-full rounded-sm border border-wiki-line bg-white px-2.5 py-2 text-base text-wiki-ink" type="text" id="media-name" spellcheck="false">
  </label>
  <label class="mb-3 flex flex-col gap-1 text-sm text-wiki-muted">{{ t .Lang "media.alt" }}
    <input class="w-full rounded-sm border border-wiki-line bg-white px-2.5 py-2 text-base text-wiki-ink" type="text" id="media-alt">
  </label>
  <div class="mb-3 grid grid-cols-2 gap-2">
    <label class="flex flex-col gap-1 text-sm text-wiki-muted">{{ t .Lang "media.width" }}
      <input class="w-full rounded-sm border border-wiki-line bg-white px-2.5 py-2 text-base text-wiki-ink" type="number" id="media-width" min="1" max="4096" placeholder="px">
    </label>
    <label class="flex flex-col gap-1 text-sm text-wiki-muted">{{ t .Lang "media.height" }}
      <input class="w-full rounded-sm border border-wiki-line bg-white px-2.5 py-2 text-base text-wiki-ink" type="number" id="media-height" min="1" max="4096" placeholder="px">
    </label>
  </div>
  <p class="mb-2 hidden text-sm text-wiki-danger" id="media-upload-error"></p>
  <button class="wiki-btn" type="button" id="media-upload">{{ t .Lang "media.upload_insert" }}</button>
</dialog>

<dialog class="m-auto w-[min(36rem,calc(100vw-2rem))] max-h-[min(40rem,calc(100vh-2rem))] overflow-auto rounded-sm border border-wiki-line bg-white p-4 text-wiki-ink shadow-lg backdrop:bg-black/30" id="media-pick-dialog">
  <form method="dialog" class="mb-3 flex items-start justify-between gap-3">
    <h2 class="m-0 font-serif text-xl font-normal">{{ t .Lang "media.pick_title" }}</h2>
    <button class="inline-flex min-h-8 cursor-pointer items-center rounded-sm border border-wiki-line bg-wiki-well px-2 py-1 text-sm" value="cancel" type="submit">{{ t .Lang "common.close" }}</button>
  </form>
  <div class="mb-3 grid grid-cols-2 gap-2">
    <label class="flex flex-col gap-1 text-sm text-wiki-muted">{{ t .Lang "media.width" }}
      <input class="w-full rounded-sm border border-wiki-line bg-white px-2.5 py-2 text-base text-wiki-ink" type="number" id="media-pick-width" min="1" max="4096" placeholder="px">
    </label>
    <label class="flex flex-col gap-1 text-sm text-wiki-muted">{{ t .Lang "media.height" }}
      <input class="w-full rounded-sm border border-wiki-line bg-white px-2.5 py-2 text-base text-wiki-ink" type="number" id="media-pick-height" min="1" max="4096" placeholder="px">
    </label>
  </div>
  <p class="mb-2 hidden text-sm text-wiki-danger" id="media-list-error"></p>
  <p class="mt-0 mb-2 text-sm text-wiki-muted" id="media-list-empty">{{ t .Lang "media.empty" }}</p>
  <ul class="m-0 list-none space-y-2 p-0" id="media-list"></ul>
  <nav class="mt-3 hidden items-center justify-between gap-2" id="media-pager">
    <button class="inline-flex min-h-8 cursor-pointer items-center rounded-sm border border-wiki-line bg-wiki-well px-2 py-1 text-sm disabled:cursor-default disabled:opacity-40" type="button" id="media-page-prev">{{ t .Lang "media.prev" }}</button>
    <span class="text-sm text-wiki-muted" id="media-page-label"></span>
    <button class="inline-flex min-h-8 cursor-pointer items-center rounded-sm border border-wiki-line bg-wiki-well px-2 py-1 text-sm disabled:cursor-default disabled:opacity-40" type="button" id="media-page-next">{{ t .Lang "media.next" }}</button>
  </nav>
</dialog>
{{end}}
