{{define "content"}}
{{template "title" "Ветки"}}
{{template "error" .Error}}
{{template "notice" .Notice}}

<p class="mb-4">Публичная ветка открыта без входа и попадает в карту сайта. Приватная видна только после входа.</p>

<div class="mb-4">
  <button class="wiki-btn" type="button" data-open-dialog="branch-create-dialog" data-reset-form="branch-create-form">Новая ветка</button>
</div>

{{template "table-start"}}
    {{template "th" "Имя"}}
    {{template "th" "Доступ"}}
    {{template "th" "Действия"}}
{{template "table-body"}}
    {{range .Branches}}
    {{template "tr-start"}}
        {{template "td-start" "Имя"}}<a href="{{if eq .Name "main"}}/{{else}}/b/{{.Name}}{{end}}">{{.Name}}</a>{{template "td-end"}}
        {{template "td-start" "Доступ"}}{{if .Public}}публичная{{else}}приватная{{end}}{{template "td-end"}}
        {{template "td-start" "Действия"}}
            <form method="POST" action="/branches" class="m-0 flex flex-wrap items-center gap-1.5">
              <input type="hidden" name="csrf" value="{{$.CSRF}}">
              <input type="hidden" name="name" value="{{.Name}}">
              {{if .Public}}
              {{template "button" (dict "Type" "submit" "Name" "action" "Value" "private" "Label" "Сделать приватной")}}
              {{else}}
              {{template "button" (dict "Type" "submit" "Name" "action" "Value" "public" "Label" "Сделать публичной")}}
              {{end}}
              {{if ne .Name "main"}}
              {{template "button" (dict "Type" "submit" "Name" "action" "Value" "delete" "Label" "Удалить")}}
              {{end}}
            </form>
        {{template "td-end"}}
    {{template "tr-end"}}
    {{end}}
{{template "table-end"}}

<dialog class="wiki-dialog" id="branch-create-dialog">
  <form method="dialog" class="mb-3 flex items-start justify-between gap-3">
    <h2 class="m-0 font-serif text-xl font-normal">Новая ветка</h2>
    <button class="wiki-btn" value="cancel" type="submit">Закрыть</button>
  </form>
  {{if eq .Form "create"}}{{template "error" .Error}}{{end}}
  <form method="POST" action="/branches" id="branch-create-form">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <input type="hidden" name="action" value="create">
    {{template "field" (dict "Label" "Имя" "Type" "text" "Name" "name" "Value" (and (eq .Form "create") .Draft.Name) "Required" true "Max" 32 "Placeholder" "например: docs" "Autocomplete" "off")}}
    {{template "check" (dict "Name" "public" "Value" "1" "Label" "Публичная" "Checked" (and (eq .Form "create") .Draft.Public))}}
    <button class="wiki-btn wiki-btn-solid" type="submit">Создать</button>
  </form>
</dialog>
<div hidden data-open-on-load="{{if eq .Form "create"}}branch-create-dialog{{end}}"></div>
{{end}}
