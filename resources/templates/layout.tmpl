<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{block "title" .}}Wiki{{end}}</title>
    <style>
        body {
            font-family: system-ui, sans-serif;
            max-width: 760px;
            margin: 2rem auto;
            padding: 0 1rem;
            line-height: 1.6;
            color: #24292f
        }

        a {
            color: #0969da;
            text-decoration: none
        }

        a:hover {
            text-decoration: underline
        }

        pre {
            background: #f6f8fa;
            padding: 1rem;
            overflow: auto;
            border-radius: 6px
        }

        code {
            background: #f6f8fa;
            padding: .15em .35em;
            border-radius: 4px;
            font-family: ui-monospace, monospace
        }

        pre code {
            background: none;
            padding: 0
        }

        ul {
            padding-left: 1.5rem
        }

        .nav {
            margin-bottom: 1.5rem;
            font-size: .9rem;
            color: #57606a
        }

        .revisions {
            font-size: .85rem;
            color: #57606a;
            margin-top: 3rem;
            border-top: 1px solid #d0d7de;
            padding-top: 1rem
        }

        .revisions li {
            list-style: none;
            padding: .2rem 0
        }
    </style>
</head>
<body>
<div class="nav"><a href="/"><- Wiki</a></div>
{{block "content" .}}{{end}}
</body>
</html>