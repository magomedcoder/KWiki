{{define "content"}}
{{template "title" (t .Lang "users.title")}}
{{template "error" .Error}}
{{template "notice" .Notice}}

<div class="mb-4">
  <button class="wiki-btn" type="button" data-open-dialog="user-create-dialog" data-reset-form="user-create-form">{{ t .Lang "users.new" }}</button>
</div>

{{template "table-start"}}
    {{template "th" (t .Lang "users.first_name")}}
    {{template "th" (t .Lang "users.email")}}
    {{template "th" (t .Lang "users.status")}}
    {{template "th" (t .Lang "common.actions")}}
{{template "table-body"}}
    {{range .Users}}
    {{template "tr-start"}}
        {{template "td-start" (t $.Lang "users.first_name")}}{{.FirstName}} {{.LastName}}{{template "td-end"}}
        {{template "td-start" (t $.Lang "users.email")}}{{.Email}}{{template "td-end"}}
        {{template "td-start" (t $.Lang "users.status")}}{{if .Admin}}{{ t $.Lang "users.administrator" }}{{end}}{{if and .Admin .Blocked}}, {{end}}{{if .Blocked}}{{ t $.Lang "users.blocked" }}{{end}}{{template "td-end"}}
        {{template "td-start" (t $.Lang "common.actions")}}
            <div class="flex flex-wrap items-center gap-1.5">
            <button class="wiki-btn" type="button" data-user-edit data-email="{{.Email}}" data-first="{{.FirstName}}" data-last="{{.LastName}}" data-admin="{{if .Admin}}1{{end}}" data-blocked="{{if .Blocked}}1{{end}}" data-self="{{if .Self}}1{{end}}">{{ t $.Lang "common.edit" }}</button>
            {{if .Self}}
            <span class="text-sm text-wiki-muted">{{ t $.Lang "users.self" }}</span>
            {{else}}
            <button class="wiki-btn" type="button" data-user-delete data-email="{{.Email}}" data-name="{{.FirstName}} {{.LastName}}">{{ t $.Lang "common.delete" }}</button>
            {{end}}
            </div>
        {{template "td-end"}}
    {{template "tr-end"}}
    {{end}}
{{template "table-end"}}

<dialog class="wiki-dialog" id="user-create-dialog">
  <form method="dialog" class="mb-3 flex items-start justify-between gap-3">
    <h2 class="m-0 font-serif text-xl font-normal">{{ t .Lang "users.new" }}</h2>
    <button class="wiki-btn" value="cancel" type="submit">{{ t .Lang "common.close" }}</button>
  </form>
  {{if eq .Form "create"}}{{template "error" .Error}}{{end}}
  <form method="POST" action="/users" id="user-create-form">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <input type="hidden" name="action" value="create">
    <div class="grid items-start gap-x-8 md:grid-cols-2">
    {{template "field" (dict "Label" (t .Lang "users.first_name") "Type" "text" "Name" "first_name" "Value" (and (eq .Form "create") .Draft.FirstName) "Required" true "Max" 80 "Autocomplete" "off")}}
    {{template "field" (dict "Label" (t .Lang "users.last_name") "Type" "text" "Name" "last_name" "Value" (and (eq .Form "create") .Draft.LastName) "Required" true "Max" 80 "Autocomplete" "off")}}
    {{template "field" (dict "Label" (t .Lang "users.email") "Type" "email" "Name" "email" "Value" (and (eq .Form "create") .Draft.Email) "Required" true "Autocomplete" "off")}}
    {{template "field" (dict "Label" (t .Lang "users.password") "Type" "password" "Name" "password" "Required" true "Autocomplete" "new-password")}}
    </div>
    {{template "check" (dict "Name" "admin" "Value" "1" "Label" (t .Lang "users.admin") "Checked" (and (eq .Form "create") .Draft.Admin))}}
    {{template "actions-start"}}
      <button class="wiki-btn wiki-btn-solid" type="submit">{{ t .Lang "common.create" }}</button>
    {{template "actions-end"}}
  </form>
</dialog>

<dialog class="wiki-dialog" id="user-edit-dialog">
  <form method="dialog" class="mb-3 flex items-start justify-between gap-3">
    <h2 class="m-0 font-serif text-xl font-normal">{{ t .Lang "users.edit_title" }}</h2>
    <button class="wiki-btn" value="cancel" type="submit">{{ t .Lang "common.close" }}</button>
  </form>
  {{if eq .Form "update"}}{{template "error" .Error}}{{end}}
  <form method="POST" action="/users" id="user-edit-form">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <input type="hidden" name="action" value="update">
    <input type="hidden" name="original_email" value="{{if eq .Form "update"}}{{.Draft.OriginalEmail}}{{end}}">
    <div class="grid items-start gap-x-8 md:grid-cols-2">
    {{template "field" (dict "Label" (t .Lang "users.first_name") "Type" "text" "Name" "first_name" "Value" (and (eq .Form "update") .Draft.FirstName) "Required" true "Max" 80 "Autocomplete" "off")}}
    {{template "field" (dict "Label" (t .Lang "users.last_name") "Type" "text" "Name" "last_name" "Value" (and (eq .Form "update") .Draft.LastName) "Required" true "Max" 80 "Autocomplete" "off")}}
    {{template "field" (dict "Label" (t .Lang "users.email") "Type" "email" "Name" "email" "Value" (and (eq .Form "update") .Draft.Email) "Required" true "Autocomplete" "off")}}
    </div>
    {{template "check" (dict "Name" "admin" "Value" "1" "Label" (t .Lang "users.admin") "Checked" (and (eq .Form "update") .Draft.Admin))}}
    <div id="user-edit-blocked"{{if and (eq .Form "update") .Draft.Self}} hidden{{end}}>
      {{template "check" (dict "Name" "blocked" "Value" "1" "Label" (t .Lang "users.blocked_label") "Checked" (and (eq .Form "update") .Draft.Blocked))}}
    </div>
    <div id="user-edit-password"{{if and (eq .Form "update") .Draft.Self}} hidden{{end}}>
      {{template "field" (dict "Label" (t .Lang "users.new_password") "Type" "password" "Name" "password" "Autocomplete" "new-password" "Placeholder" (t .Lang "users.password_placeholder"))}}
    </div>
    {{template "actions-start"}}
      <button class="wiki-btn wiki-btn-solid" type="submit">{{ t .Lang "common.save" }}</button>
    {{template "actions-end"}}
  </form>
</dialog>

<dialog class="wiki-dialog" id="user-delete-dialog">
  <form method="dialog" class="mb-3 flex items-start justify-between gap-3">
    <h2 class="m-0 font-serif text-xl font-normal">{{ t .Lang "users.delete_title" }}</h2>
    <button class="wiki-btn" value="cancel" type="submit">{{ t .Lang "common.close" }}</button>
  </form>
  {{if eq .Form "delete"}}{{template "error" .Error}}{{end}}
  <p class="mt-0 mb-4" id="user-delete-label">{{ t .Lang "users.delete_confirm" (t .Lang "users.delete_fallback") }}</p>
  <form method="POST" action="/users" id="user-delete-form">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <input type="hidden" name="action" value="delete">
    <input type="hidden" name="email" value="{{if eq .Form "delete"}}{{.Draft.Email}}{{end}}">
    <div class="flex flex-wrap items-center gap-2">
      <button class="wiki-btn wiki-btn-solid" type="submit">{{ t .Lang "common.delete" }}</button>
      <button class="wiki-btn" type="button" data-close-dialog="user-delete-dialog">{{ t .Lang "common.cancel" }}</button>
    </div>
  </form>
</dialog>
<div hidden data-open-on-load="{{if eq .Form "create"}}user-create-dialog{{else if eq .Form "update"}}user-edit-dialog{{else if eq .Form "delete"}}user-delete-dialog{{end}}"></div>
{{end}}
