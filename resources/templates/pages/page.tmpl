{{define "content"}}
<article>
  {{if .Email}}
    {{if .Missing}}
      {{template "tabs" (dict "Aria" (t .Lang "nav.page_actions") "Items" (list (dict "Label" (t .Lang "page.create") "Href" .EditHref "Current" true)))}}
    {{else}}
      {{template "tabs" (dict "Aria" (t .Lang "nav.page_actions") "Items" (list (dict "Label" (t .Lang "page.read") "Current" true) (dict "Label" (t .Lang "page.edit") "Href" .EditHref)))}}
    {{end}}
  {{end}}

  {{if not .IsHome}}<h1 id="page-title" class="mt-0 mb-3.5 border-b border-wiki-line pb-1 font-serif text-[1.85rem] leading-tight font-normal max-md:text-[1.55rem]">{{.Title}}</h1>{{end}}

  {{if .Missing}}
    <p class="text-wiki-muted">{{ t .Lang "page.missing_start" }} {{template "code" .Slug}}{{ t .Lang "page.missing_end" }}</p>
  {{else}}
    {{template "prose" (dict "Body" .Body)}}
    {{if .HistoryHref}}
    <p class="mt-6 flex justify-end print:hidden"><a class="text-sm text-wiki-faint no-underline underline-offset-2 hover:text-wiki-ink hover:underline" href="{{.HistoryHref}}">{{ t .Lang "page.history" }}</a></p>
    {{end}}
  {{end}}
</article>
{{end}}
