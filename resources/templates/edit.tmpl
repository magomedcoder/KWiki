{{define "content"}}
<h1>{{.Title}}</h1>
<form method="POST" action="/edit" class="editor">
  <input type="hidden" name="csrf" value="{{.CSRF}}">
  <label>
    Ветка
    {{if .IsNew}}
    <select name="branch">
      {{range .Branches}}
      <option value="{{.Name}}" {{if eq .Name $.Branch}}selected{{end}}>{{.Name}}{{if not .Public}} (приватная){{end}}</option>
      {{end}}
    </select>
    {{else}}
    <input type="hidden" name="branch" value="{{.Branch}}">
    <input type="text" value="{{.Branch}}" readonly>
    {{end}}
  </label>
  <label>
    Адрес
    <input
      type="text"
      name="slug"
      value="{{.Slug}}"
      placeholder="например: zametki/vvedenie"
      {{if not .IsNew}}readonly{{end}}
      required
      autofocus
    >
  </label>

  <label>
    Текст
    <textarea
      name="content"
      rows="24"
      spellcheck="false"
      required
    >{{.Content}}</textarea>
  </label>

  <div class="actions">
    <button type="submit">Сохранить</button>
    <a href="{{if .Slug}}{{if eq .Branch "main"}}/{{.Slug}}{{else}}/b/{{.Branch}}/{{.Slug}}{{end}}{{else}}{{.Home}}{{end}}">Отмена</a>
  </div>
</form>
{{end}}
