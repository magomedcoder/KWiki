<!DOCTYPE html>
<html lang="ru" class="bg-white">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f4f5f7">
    <title>{{.Title}} | KWiki</title>
    {{if .Indexable}}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    {{if .Canonical}}<link rel="canonical" href="{{.Canonical}}">{{end}}
    {{if .Description}}
    <meta name="description" content="{{.Description}}">
    <meta property="og:description" content="{{.Description}}">
    {{end}}
    <meta property="og:title" content="{{.Title}}">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="ru_RU">
    {{if .Canonical}}<meta property="og:url" content="{{.Canonical}}">{{end}}
    {{if .Modified}}<meta property="article:modified_time" content="{{.Modified}}">{{end}}
    {{else}}
    <meta name="robots" content="noindex, nofollow">
    {{end}}
    <link rel="stylesheet" href="/css/tailwindcss.css">
</head>
<body class="group min-h-screen bg-white font-sans text-base leading-normal text-wiki-ink antialiased print:bg-white">
{{if .Headings}}<input class="nav-toggle sr-only" type="checkbox" id="nav-open">{{end}}
<div class="flex min-h-screen flex-col">
{{template "header" .}}
{{if .Headings}}<label class="hidden max-md:group-has-[.nav-toggle:checked]:fixed max-md:group-has-[.nav-toggle:checked]:inset-0 max-md:group-has-[.nav-toggle:checked]:z-30 max-md:group-has-[.nav-toggle:checked]:block max-md:group-has-[.nav-toggle:checked]:bg-wiki-ink/30" for="nav-open"></label>{{end}}
<div class="flex w-full flex-1 flex-col md:group-has-[.wiki-toc]:grid md:group-has-[.wiki-toc]:grid-cols-[16rem_minmax(0,1fr)] print:block">
    {{if .Headings}}{{template "sidebar" .}}{{end}}
    <div class="flex min-w-0 flex-1 flex-col">
        <main class="min-w-0 flex-1 px-4 py-5 ps-[max(1rem,env(safe-area-inset-left))] pe-[max(1rem,env(safe-area-inset-right))] md:px-8 md:py-6 print:p-0">
            {{template "content" .}}
        </main>
        {{template "footer" .}}
    </div>
</div>
</div>
</body>
</html>
