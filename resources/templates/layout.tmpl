<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{.Title}} | KWiki</title>
    {{if .Indexable}}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    {{if .Canonical}}<link rel="canonical" href="{{.Canonical}}">{{end}}
    {{if .Description}}
    <meta name="description" content="{{.Description}}">
    <meta property="og:description" content="{{.Description}}">
    {{end}}
    <meta property="og:title" content="{{.Title}}">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="ru_RU">
    {{if .Canonical}}<meta property="og:url" content="{{.Canonical}}">{{end}}
    {{if .Modified}}<meta property="article:modified_time" content="{{.Modified}}">{{end}}
    {{else}}
    <meta name="robots" content="noindex, nofollow">
    {{end}}
    <style>
        body {
            font-family: system-ui, sans-serif;
            max-width: 900px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        header.site {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eee;
            padding-bottom: .5rem;
        }

        header.site a {
            text-decoration: none;
            color: inherit;
        }

        header.site nav {
            display: flex;
            gap: .8rem;
            align-items: center;
        }

        .logout {
            display: inline;
            margin: 0;
        }

        .logout button {
            font: inherit;
            background: none;
            border: none;
            padding: 0;
            color: inherit;
            cursor: pointer;
            text-decoration: underline;
        }

        .error {
            color: #8a1f1f;
            background: #fdecec;
            padding: .6rem .8rem;
            border-radius: 4px;
        }

        .notice {
            color: #145214;
            background: #eef6ee;
            padding: .6rem .8rem;
            border-radius: 4px;
        }

        .check {
            display: flex;
            gap: .4rem;
            align-items: center;
        }

        table.users {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1.5rem;
        }

        table.users th,
        table.users td {
            text-align: left;
            padding: .45rem .3rem;
            border-bottom: 1px solid #eee;
            vertical-align: middle;
        }

        .row-actions {
            display: flex;
            gap: .4rem;
            align-items: center;
        }

        .row-actions form {
            margin: 0;
        }

        .page-actions {
            margin: .5rem 0;
        }

        .btn {
            display: inline-block;
            padding: .35rem .7rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            text-decoration: none;
            color: #222;
        }

        .editor label {
            display: block;
            margin: .8rem 0;
        }

        .editor input[type=text],
        .editor input[type=email],
        .editor input[type=password],
        .editor select,
        .editor textarea {
            width: 100%;
            padding: .5rem;
            font-family: inherit;
            font-size: 14px;
            box-sizing: border-box;
        }

        .editor textarea {
            font-family: ui-monospace, monospace;
        }

        .actions {
            display: flex;
            gap: .5rem;
            align-items: center;
        }

        .history ul {
            list-style: none;
            padding: 0;
        }

        .history li {
            display: flex;
            gap: .7rem;
            padding: .3rem 0;
            border-bottom: 1px solid #f0f0f0;
            font-size: 14px;
        }

        nav.branches {
            display: flex;
            flex-wrap: wrap;
            gap: .7rem;
            margin: 1rem 0;
        }

        code {
            background: #f5f5f5;
            padding: 1px 4px;
            border-radius: 3px;
        }
    </style>
</head>
<body>
<header class="site">
    <a href="{{.Home}}"><strong>KWiki</strong></a>
    <nav>
        {{if .Email}}
        <a href="{{.Home}}">Страницы</a>
        <a href="{{.NewHref}}">Новая страница</a>
        {{if .Admin}}<a href="/branches">Ветки</a>{{end}}
        {{if .Admin}}<a href="/users">Пользователи</a>{{end}}
        <span>{{.Name}}</span>
        <form method="POST" action="/logout" class="logout">
            <input type="hidden" name="csrf" value="{{.CSRF}}">
            <button type="submit">Выйти</button>
        </form>
        {{end}}
    </nav>
</header>
<main>
    {{template "content" .}}
</main>
</body>
</html>