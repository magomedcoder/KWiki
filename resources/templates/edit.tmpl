{{define "content"}}
<h1>{{.Title}}</h1>
<form method="POST" action="/edit" class="editor">
  <input type="hidden" name="csrf" value="{{.CSRF}}">
  <label>
    Ветка
    {{if .IsNew}}
    <select name="branch">
      {{range .Branches}}
      <option value="{{.Name}}" {{if eq .Name $.Branch}}selected{{end}}>{{.Name}}{{if not .Public}} (приватная){{end}}</option>
      {{end}}
    </select>
    {{else}}
    <input type="hidden" name="branch" value="{{.Branch}}">
    <input type="text" value="{{.Branch}}" readonly>
    {{end}}
  </label>
  <label>
    Адрес
    <input
      type="text"
      name="slug"
      value="{{.Slug}}"
      {{if not .IsNew}}readonly{{end}}
      required
    >
  </label>

  <div class="editor-bar">
    <div class="editor-tools">
      <button type="button" data-before="**" data-after="**" data-placeholder="текст">Жирный</button>
      <button type="button" data-before="*" data-after="*" data-placeholder="текст">Курсив</button>
      <button type="button" data-before="# " data-after="" data-placeholder="Заголовок">Заголовок</button>
      <button type="button" data-before="- " data-after="" data-placeholder="пункт">Список</button>
      <button type="button" data-before="`" data-after="`" data-placeholder="код">Код</button>
      <button type="button" data-before="[" data-after="](адрес)" data-placeholder="ссылка">Ссылка</button>
    </div>
    <div class="editor-modes">
      <button type="button" data-mode="split" class="is-active">Правка</button>
      <button type="button" data-mode="preview">Просмотр</button>
    </div>
  </div>

  <div class="editor-split" data-mode="split">
    <label class="editor-source">
      Текст
      <textarea
        name="content"
        rows="24"
        spellcheck="false"
        required
      >{{.Content}}</textarea>
    </label>
    <section class="preview" aria-live="polite">
      <div class="preview-body content">{{.Preview}}</div>
    </section>
  </div>

  <div class="actions">
    <button type="submit">Сохранить</button>
    <a href="{{.Cancel}}">Отмена</a>
  </div>
</form>
<script src="/static/main.js"></script>
{{end}}
