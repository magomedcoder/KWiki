{{define "content"}}
{{template "title" (t .Lang "branches.title")}}
{{template "error" .Error}}
{{template "notice" .Notice}}

<p class="mb-4">{{ t .Lang "branches.intro" }}</p>

<div class="mb-4">
  <button class="wiki-btn" type="button" data-open-dialog="branch-create-dialog" data-reset-form="branch-create-form">{{ t .Lang "branches.new" }}</button>
</div>

{{template "table-start"}}
    {{template "th" (t .Lang "common.name")}}
    {{template "th" (t .Lang "branches.access")}}
    {{template "th" (t .Lang "common.actions")}}
{{template "table-body"}}
    {{range .Branches}}
    {{template "tr-start"}}
        {{template "td-start" (t $.Lang "common.name")}}<a href="{{if eq .Name "main"}}/{{else}}/b/{{.Name}}{{end}}">{{.Name}}</a>{{template "td-end"}}
        {{template "td-start" (t $.Lang "branches.access")}}{{if .Public}}{{ t $.Lang "branches.public" }}{{else}}{{ t $.Lang "branches.private" }}{{end}}{{template "td-end"}}
        {{template "td-start" (t $.Lang "common.actions")}}
            <form method="POST" action="/branches" class="m-0 flex flex-wrap items-center gap-1.5">
              <input type="hidden" name="csrf" value="{{$.CSRF}}">
              <input type="hidden" name="name" value="{{.Name}}">
              {{if .Public}}
              {{template "button" (dict "Type" "submit" "Name" "action" "Value" "private" "Label" (t $.Lang "branches.make_private"))}}
              {{else}}
              {{template "button" (dict "Type" "submit" "Name" "action" "Value" "public" "Label" (t $.Lang "branches.make_public"))}}
              {{end}}
              {{if ne .Name "main"}}
              {{template "button" (dict "Type" "submit" "Name" "action" "Value" "delete" "Label" (t $.Lang "common.delete"))}}
              {{end}}
            </form>
        {{template "td-end"}}
    {{template "tr-end"}}
    {{end}}
{{template "table-end"}}

<dialog class="wiki-dialog" id="branch-create-dialog">
  <form method="dialog" class="mb-3 flex items-start justify-between gap-3">
    <h2 class="m-0 font-serif text-xl font-normal">{{ t .Lang "branches.new" }}</h2>
    <button class="wiki-btn" value="cancel" type="submit">{{ t .Lang "common.close" }}</button>
  </form>
  {{if eq .Form "create"}}{{template "error" .Error}}{{end}}
  <form method="POST" action="/branches" id="branch-create-form">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <input type="hidden" name="action" value="create">
    {{template "field" (dict "Label" (t .Lang "common.name") "Type" "text" "Name" "name" "Value" (and (eq .Form "create") .Draft.Name) "Required" true "Max" 32 "Placeholder" (t .Lang "branches.name_placeholder") "Autocomplete" "off")}}
    {{template "check" (dict "Name" "public" "Value" "1" "Label" (t .Lang "branches.public_label") "Checked" (and (eq .Form "create") .Draft.Public))}}
    <button class="wiki-btn wiki-btn-solid" type="submit">{{ t .Lang "common.create" }}</button>
  </form>
</dialog>
<div hidden data-open-on-load="{{if eq .Form "create"}}branch-create-dialog{{end}}"></div>
{{end}}
