{{define "content"}}
<article>
  {{template "tabs" (dict "Aria" (t .Lang "nav.branch_nav") "Items" (list
    (dict "Label" (t .Lang "nav.pages") "Href" .Home "Current" false)
    (dict "Label" (t .Lang "nav.files") "Href" .FilesRoot "Current" true)
  ))}}

  <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <h1 id="page-title" class="m-0 border-b border-wiki-line pb-1 font-serif text-[1.85rem] leading-tight font-normal max-md:text-[1.55rem]">{{.Title}}</h1>
    {{if .Branches}}
    <label class="block text-sm text-wiki-muted print:hidden">
      <span class="mb-1 block text-xs tracking-wider text-wiki-faint uppercase">{{ t .Lang "files.branch" }}</span>
      <select class="min-w-[10rem] rounded-sm border border-wiki-line bg-white px-2.5 py-2 text-base text-wiki-ink focus:border-wiki-muted focus:outline-2 focus:outline-[#d9dde3]" id="files-branch" onchange="if (this.value) location.href = this.value">
        {{range .Branches}}
        <option value="{{.Href}}" {{if .Current}}selected{{end}}>{{.Name}}{{if not .Public}}{{ t $.Lang "edit.branch_private" }}{{end}}</option>
        {{end}}
      </select>
    </label>
    {{end}}
  </div>

  <nav class="mb-4 flex flex-wrap items-center gap-1 text-sm" aria-label="{{ t .Lang "files.breadcrumbs" }}">
    {{range $i, $c := .Crumbs}}
      {{if $i}}<span class="text-wiki-faint">/</span>{{end}}
      {{if eq $c.Href $.CurrentHref}}
      <span class="font-semibold text-wiki-ink">{{$c.Name}}</span>
      {{else}}
      <a class="text-wiki-link no-underline hover:underline" href="{{$c.Href}}">{{$c.Name}}</a>
      {{end}}
    {{end}}
  </nav>

  {{if and .CanEdit .IsDir}}
  <div class="mb-5 flex flex-wrap gap-2 print:hidden">
    <details class="relative">
      <summary class="wiki-btn cursor-pointer list-none">{{ t .Lang "files.upload" }}</summary>
      <form method="POST" action="{{.CurrentHref}}" enctype="multipart/form-data" class="mt-2 min-w-[16rem] rounded-sm border border-wiki-line bg-white p-3 shadow-sm">
        <input type="hidden" name="csrf" value="{{.CSRF}}">
        <input type="hidden" name="action" value="upload">
        <label class="mb-2 block text-sm">{{ t .Lang "files.choose_file" }}
          <input class="mt-1 block w-full text-sm" type="file" name="file" required>
        </label>
        <label class="mb-2 flex items-center gap-2 text-sm"><input type="checkbox" name="overwrite" value="1"> {{ t .Lang "files.overwrite" }}</label>
        <button class="wiki-btn wiki-btn-solid" type="submit">{{ t .Lang "files.upload" }}</button>
      </form>
    </details>
    <details class="relative">
      <summary class="wiki-btn cursor-pointer list-none">{{ t .Lang "files.create_file" }}</summary>
      <form method="POST" action="{{.CurrentHref}}" class="mt-2 min-w-[16rem] rounded-sm border border-wiki-line bg-white p-3 shadow-sm">
        <input type="hidden" name="csrf" value="{{.CSRF}}">
        <input type="hidden" name="action" value="create">
        <label class="mb-2 block text-sm">{{ t .Lang "files.name" }}
          <input class="mt-1 w-full rounded-sm border border-wiki-line px-2 py-1.5 font-mono text-sm" name="name" required placeholder="notes.md">
        </label>
        <label class="mb-2 block text-sm">{{ t .Lang "files.content" }}
          <textarea class="mt-1 w-full rounded-sm border border-wiki-line px-2 py-1.5 font-mono text-sm" name="content" rows="4"></textarea>
        </label>
        <button class="wiki-btn wiki-btn-solid" type="submit">{{ t .Lang "files.create_file" }}</button>
      </form>
    </details>
    <details class="relative">
      <summary class="wiki-btn cursor-pointer list-none">{{ t .Lang "files.create_dir" }}</summary>
      <form method="POST" action="{{.CurrentHref}}" class="mt-2 min-w-[16rem] rounded-sm border border-wiki-line bg-white p-3 shadow-sm">
        <input type="hidden" name="csrf" value="{{.CSRF}}">
        <input type="hidden" name="action" value="create">
        <input type="hidden" name="dir" value="1">
        <label class="mb-2 block text-sm">{{ t .Lang "files.name" }}
          <input class="mt-1 w-full rounded-sm border border-wiki-line px-2 py-1.5 font-mono text-sm" name="name" required placeholder="docs">
        </label>
        <button class="wiki-btn wiki-btn-solid" type="submit">{{ t .Lang "files.create_dir" }}</button>
      </form>
    </details>
    <details class="relative">
      <summary class="wiki-btn cursor-pointer list-none">{{ t .Lang "files.move" }}</summary>
      <form method="POST" action="{{.CurrentHref}}" class="mt-2 min-w-[18rem] rounded-sm border border-wiki-line bg-white p-3 shadow-sm">
        <input type="hidden" name="csrf" value="{{.CSRF}}">
        <input type="hidden" name="action" value="move">
        <label class="mb-2 block text-sm">{{ t .Lang "files.from" }}
          <input class="mt-1 w-full rounded-sm border border-wiki-line px-2 py-1.5 font-mono text-sm" name="from" required placeholder="old/name.md">
        </label>
        <label class="mb-2 block text-sm">{{ t .Lang "files.to" }}
          <input class="mt-1 w-full rounded-sm border border-wiki-line px-2 py-1.5 font-mono text-sm" name="to" required placeholder="new/name.md">
        </label>
        <button class="wiki-btn wiki-btn-solid" type="submit">{{ t .Lang "files.move" }}</button>
      </form>
    </details>
  </div>
  {{end}}

  {{if .IsDir}}
    {{if .Empty}}
    <p class="rounded-sm border border-wiki-line-soft bg-wiki-well px-3 py-4 text-sm text-wiki-muted">{{ t .Lang "files.empty" }}</p>
    {{else}}
    {{template "table-start"}}
      {{template "th" (t .Lang "files.col_name")}}
      {{template "th" (t .Lang "files.col_size")}}
      {{template "th" (t .Lang "files.col_actions")}}
    {{template "table-body"}}
    {{range .Entries}}
      {{template "tr-start"}}
        {{template "td-start" (t $.Lang "files.col_name")}}
          <a class="inline-flex items-center gap-2 text-wiki-link no-underline hover:underline" href="{{.Href}}">
            <span class="inline-block min-w-8 text-xs tracking-wide text-wiki-faint uppercase" aria-hidden="true">{{if eq .Icon "dir"}}dir{{else if eq .Icon "md"}}md{{else if eq .Icon "image"}}img{{else if eq .Icon "video"}}vid{{else}}file{{end}}</span>
            <span class="font-mono text-sm">{{.Name}}</span>
          </a>
          {{if .PageHref}}
          <a class="ms-2 text-xs text-wiki-faint no-underline hover:underline" href="{{.PageHref}}">{{ t $.Lang "files.open_page" }}</a>
          {{end}}
        {{template "td-end"}}
        {{template "td-start" (t $.Lang "files.col_size")}}
          <span class="font-mono text-xs text-wiki-muted">{{.SizeText}}</span>
        {{template "td-end"}}
        {{template "td-start" (t $.Lang "files.col_actions")}}
          {{if $.CanEdit}}
          <form method="POST" action="{{$.CurrentHref}}" class="m-0 inline" data-confirm-delete="{{.Path}}">
            <input type="hidden" name="csrf" value="{{$.CSRF}}">
            <input type="hidden" name="action" value="delete">
            <input type="hidden" name="path" value="{{.Path}}">
            <button class="cursor-pointer border-0 bg-transparent p-0 text-xs text-wiki-danger underline-offset-2 hover:underline" type="submit">{{ t $.Lang "files.delete" }}</button>
          </form>
          {{else}}
          <span class="text-wiki-faint">-</span>
          {{end}}
        {{template "td-end"}}
      {{template "tr-end"}}
    {{end}}
    {{template "table-end"}}
    {{end}}
  {{else}}
    <div class="mb-4 flex flex-wrap gap-2 print:hidden">
      <a class="wiki-btn" href="{{.RawHref}}">{{ t .Lang "files.download" }}</a>
      {{if .PageHref}}<a class="wiki-btn" href="{{.PageHref}}">{{ t .Lang "files.open_page" }}</a>{{end}}
      {{if .EditHref}}<a class="wiki-btn" href="{{.EditHref}}">{{ t .Lang "page.edit" }}</a>{{end}}
      {{if .CanEdit}}
      <form method="POST" action="{{.FilesRoot}}" class="m-0" data-confirm-delete="{{.Path}}">
        <input type="hidden" name="csrf" value="{{.CSRF}}">
        <input type="hidden" name="action" value="delete">
        <input type="hidden" name="path" value="{{.Path}}">
        <button class="wiki-btn" type="submit">{{ t .Lang "files.delete" }}</button>
      </form>
      {{end}}
    </div>
    {{if .Image}}
      <img class="max-w-full" src="{{.RawHref}}" alt="{{.Path}}">
    {{else if .Video}}
      <video class="max-w-full" src="{{.RawHref}}" controls playsinline></video>
    {{else if .Preview}}
      <pre class="m-0 overflow-auto rounded-sm border border-wiki-line-soft bg-wiki-well p-3 font-mono text-sm leading-snug">
        <code>{{.Preview}}</code>
      </pre>
    {{else}}
      <p class="text-sm text-wiki-muted">{{ t .Lang "files.binary" }}</p>
    {{end}}
  {{end}}

  {{if .CloneURL}}
  <section class="mt-8 border-t border-wiki-line-soft pt-5">
    <h2 class="mt-0 mb-2 font-serif text-xl font-normal">{{ t .Lang "files.git_title" }}</h2>
    <p class="mb-1 text-xs tracking-wider text-wiki-faint uppercase">{{ t .Lang "files.clone" }}</p>
    <pre class="m-0 mb-3 overflow-auto rounded-sm border border-wiki-line-soft bg-wiki-well p-3 font-mono text-sm"><code>git clone {{.CloneURL}}</code></pre>
    <p class="mb-1 text-xs tracking-wider text-wiki-faint uppercase">{{ t .Lang "files.push" }}</p>
    <pre class="m-0 overflow-auto rounded-sm border border-wiki-line-soft bg-wiki-well p-3 font-mono text-sm">
      <code>git remote add kwiki {{.CloneURL}} </br>git push kwiki HEAD</code>
    </pre>
    <p class="mt-3 mb-0 text-sm text-wiki-muted">{{ t .Lang "files.git_auth" }}</p>
  </section>
  {{end}}
</article>
{{end}}
