<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{.Title}} | KWiki</title>
    {{if .Indexable}}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    {{if .Canonical}}<link rel="canonical" href="{{.Canonical}}">{{end}}
    {{if .Description}}
    <meta name="description" content="{{.Description}}">
    <meta property="og:description" content="{{.Description}}">
    {{end}}
    <meta property="og:title" content="{{.Title}}">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="ru_RU">
    {{if .Canonical}}<meta property="og:url" content="{{.Canonical}}">{{end}}
    {{if .Modified}}<meta property="article:modified_time" content="{{.Modified}}">{{end}}
    {{else}}
    <meta name="robots" content="noindex, nofollow">
    {{end}}
    <link rel="stylesheet" href="/static/main.css">
</head>
<body>
<header class="site">
    <a href="{{.Home}}"><strong>KWiki</strong></a>
    <nav>
        {{if .Email}}
        <a href="{{.Home}}">Страницы</a>
        <a href="{{.NewHref}}">Новая страница</a>
        {{if .Admin}}<a href="/branches">Ветки</a>{{end}}
        {{if .Admin}}<a href="/users">Пользователи</a>{{end}}
        <span>{{.Name}}</span>
        <form method="POST" action="/logout" class="logout">
            <input type="hidden" name="csrf" value="{{.CSRF}}">
            <button type="submit">Выйти</button>
        </form>
        {{end}}
    </nav>
</header>
<main>
    {{template "content" .}}
</main>
</body>
</html>